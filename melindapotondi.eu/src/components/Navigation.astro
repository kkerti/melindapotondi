---
import { getLangFromUrl, createTranslationFunction, getAlternateUrls, languages } from '../i18n';

const lang = getLangFromUrl(Astro.url);
const t = await createTranslationFunction(Astro.url);
const alternateUrls = getAlternateUrls(Astro.url);

const navigationItems = [
  { key: 'ui.navigation.contact', href: lang === 'hu' ? '/contact' : '/en/contact' }
];
---

<nav class="bg-white shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center">
        <a href={lang === 'hu' ? '/' : '/en/'} class="text-xl font-bold text-gray-800">
          Melinda Potondi
        </a>
      </div>
      
      <!-- Navigation Links -->
      <div class="hidden md:flex items-center space-x-8">
        {navigationItems.map(item => (
          <a 
            href={item.href} 
            class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >
            {t(item.key)}
          </a>
        ))}
      </div>

      <!-- Language Switcher -->
      <div class="flex items-center space-x-4 ">
        <span class="text-sm text-gray-600">{t('ui.common.language')}:</span>
        {Object.entries(languages).map(([code, name]) => (
          <a
            href={alternateUrls[code as keyof typeof languages]}
            class={`px-2 py-1 rounded text-sm font-medium transition-colors ${
              lang === code 
                ? 'bg-blue-500 text-white' 
                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
            }`}
          >
            <span class={`fi fi-${code === "hu" ? "hu" : "eu"}`}></span>
            {code.toUpperCase()}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile menu -->
    <div class="mobile-menu hidden md:hidden">
      <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
        {navigationItems.map(item => (
          <a
            href={item.href}
            class="text-gray-600 hover:text-gray-900 block px-3 py-2 rounded-md text-base font-medium"
          >
            {t(item.key)}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const button = document.querySelector('.mobile-menu-button');
    const menu = document.querySelector('.mobile-menu');
    
    if (button && menu) {
      button.addEventListener('click', function() {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>