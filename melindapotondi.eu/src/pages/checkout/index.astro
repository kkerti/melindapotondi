---
import Layout from '@layouts/Layout.astro';
import { createTranslationFunction } from '../../i18n';
import ContactForm from '@components/forms/ContactForm.svelte';
import AddressForm from '@components/forms/AddressForm.svelte';
import { VENDURE_SHOP_API_URL } from 'astro:env/client';

const t = await createTranslationFunction(Astro.url);

const contactLabels = {
  firstName: t("ui.form.labels.firstName"),
  lastName: t("ui.form.labels.lastName"),
  emailAddress: t("ui.form.labels.emailAddress"),
  phoneNumber: t("ui.form.labels.phoneNumber"),
};

const addressLabels = {
  streetLine1: t("ui.form.labels.streetLine1"),
  streetLine2: t("ui.form.labels.streetLine2"),
  city: t("ui.form.labels.city"),
  province: t("ui.form.labels.province"),
  postalCode: t("ui.form.labels.postalCode"),
  country: t("ui.form.labels.country"),
};
---

<Layout>
  <h2 class="text-xl font-bold p-3">Contact Information</h2>
  <div class="p-3 max-w-64">
    <ContactForm client:load labels={contactLabels} endpoint={VENDURE_SHOP_API_URL} />
  </div>

  <h2 class="text-xl font-bold p-3">Shipping Address</h2>
  <div class="p-3 max-w-64">
    <AddressForm client:load labels={addressLabels} endpoint={VENDURE_SHOP_API_URL} />
  </div>
</Layout>