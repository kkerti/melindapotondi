---
// Real workshop calendar/date-picker page, protected by the password gate in
// src/middleware.ts. Replaces the placeholder that used to live here.
export const prerender = false;

import Layout from '@layouts/Layout.astro';
import WorkshopCalendar from '@components/commerce/WorkshopCalendar.svelte';
import { getWorkshopEventsInRange } from '@components/commerce/workshops';

// Today through +6 months: a sensible default window for a small workshop
// business's real event volume.
const from = new Date();
const to = new Date(from);
to.setMonth(to.getMonth() + 6);

const events = await getWorkshopEventsInRange(from, to);
---

<Layout title="Workshopok — Melinda Potondi">
  <div class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold py-2 text-center">Workshopok</h1>
    <p class="py-2 text-muted-foreground text-center mb-8">
      Válassz ki egy kiemelt dátumot a naptárban, és foglalj helyet egy közelgő kerámia workshopon.
    </p>
    <WorkshopCalendar client:load events={events} locale="hu" />
  </div>
</Layout>
