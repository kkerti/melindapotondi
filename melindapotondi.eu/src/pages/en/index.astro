---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Events from '../../components/Events.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import Contact from '../../components/Contact.astro';
import Gallery from '../../components/Gallery.astro';
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/Lenyek*.{jpeg,jpg,png,gif}');
---

<Layout>
	<section class="py-4 md:py-8 max-w-7xl mx-auto w-full px-4">
		<div class="max-w-prose border-4 p-4 rounded-2xl border-amber-200">
			<h2 class="font-bold text-2xl py-2">Hi, welcome on my website! :)</h2>
			<p class="py-2">I am Melinda Potondi, with a degree in animation from MoMe and a graphic design qualification from Kisképző. During my university years, I fell in love with the art of ceramics, and now, whenever I can, I spend most of my time on some kind of project that can be kneaded, painted, or fired. You can most often meet my creatures made with the never-the-same little soul animal concept on my <a class="text-blue-500 hover:text-blue-600 hover:underline" target="_BLANK" href="https://instagram.com/melinda.potondi">Instagram</a> page, or at various art fairs, mainly in Budapest.</p>
		</div>
	</section>

	<section class="container mx-auto w-full grid sm:grid-cols-2 md:grid-cols-5 justify-center gap-4 px-2 md:px-4 md:py-8">
		<Gallery/>
	</section>

    <section class="py-4 md:py-8 max-w-7xl mx-auto flex justify-center w-full px-4">
		<div class="max-w-prose justify-end border-4 p-4 border-dashed rounded-2xl border-sky-200">
			<h2 class="font-bold text-2xl py-2">New studio, workshops...</h2>
            <p class="py-2">
            In 2024, I started holding small group ceramic workshops. For a while, at the Samott Studio on Eötvös Street, I helped others create their first clay items and introduced them to the tools and procedures.
            </p>
            <p class="py-2">
            Now, in October 2025, I have set up my own <i>home studio</i> in Őrmező, where workshops will be starting again. More information about this will be coming soon on this page.
            </p>
		</div>
	</section>


    <section class="max-w-7xl mx-auto w-full px-4 md:py-8">
       <Contact/>
    </section>


	<section class="py-8 md:py-12">
		<div class="max-w-6xl mx-auto px-4">
			<Events />
		</div>
	</section>

	<section class="svg-pattern w-full mt-4 md:mt-8">
		<div class="max-w-5xl mx-auto py-4 px-4 md:py-8">
			<NewsletterForm class='w-full py-8'/>
		</div>
	</section>
</Layout>

<style>
	.svg-pattern {
        background-color: #5c0a0a30;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.46'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");	
    }
</style>
