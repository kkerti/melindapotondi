---
// Ticket reservation page for a single workshop occurrence (a ProductVariant), linked from
// the "Reserve" button on /en/workshops. Protected by the same password gate as the rest of
// /en/workshops (see src/middleware.ts) since it lives under that path prefix.
export const prerender = false;

import Layout from '@layouts/Layout.astro';
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '@lib/components/ui/card';
import WorkshopReserveForm from '@components/commerce/WorkshopReserveForm.svelte';
import { getWorkshopEvent } from '@components/commerce/workshops';

const BUDAPEST_TZ = 'Europe/Budapest';

const { id } = Astro.params;
// id is a ProductVariant id. Variants with no startsAt are not reservable (they have not
// been fully configured), so treat those as "not found" rather than rendering a broken form.
const event = id ? await getWorkshopEvent(id) : null;

// Only a truly missing variant (or one lacking a scheduled start) is a 404. Sold-out
// variants still render with a "sold out" notice instead of the reservation form.
if (!event || event.startsAt == null) {
  Astro.response.status = 404;
}

function formatDateTime(startsAt: string, endsAt: string): string {
  const dateFmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: BUDAPEST_TZ,
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
  const timeFmt = new Intl.DateTimeFormat('en-GB', {
    timeZone: BUDAPEST_TZ,
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });
  return `${dateFmt.format(new Date(startsAt))}, ${timeFmt.format(new Date(startsAt))}–${timeFmt.format(new Date(endsAt))}`;
}

function formatPrice(cents: number): string {
  return new Intl.NumberFormat('en-GB', {
    style: 'currency',
    currency: 'HUF',
    maximumFractionDigits: 0,
  }).format(cents / 100);
}

const formattedDateTime = event && event.startsAt && event.endsAt ? formatDateTime(event.startsAt, event.endsAt) : '';
const formattedPrice = event ? formatPrice(event.priceWithTax) : '';
const isSoldOut = event?.stockLevel === 'OUT_OF_STOCK';
const pageTitle = event ? `${event.productName} — Reserve — Melinda Potondi` : 'Workshop not found — Melinda Potondi';
---

<Layout title={pageTitle}>
  <div class="max-w-lg mx-auto px-4 py-16">
    {!event ? (
      <div class="space-y-4 text-center">
        <h1 class="text-2xl font-bold">Workshop not found.</h1>
        <p class="text-muted-foreground">This workshop doesn't exist, or is no longer available.</p>
        <a href="/en/workshops" class="text-primary underline">Back to workshops</a>
      </div>
    ) : (
      <div class="space-y-6">
        <Card>
          <CardHeader>
            <CardTitle>{event.productName}</CardTitle>
            <CardDescription>
              {formattedDateTime}
              {event.location ? ` &middot; Location: ${event.location}` : ''}
            </CardDescription>
          </CardHeader>
          <CardContent class="space-y-3">
            {event.description && (
              <p class="text-sm text-muted-foreground">{event.description}</p>
            )}
            <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
              <span class="font-medium">{formattedPrice}</span>
              <span class={isSoldOut ? 'text-destructive' : 'text-muted-foreground'}>
                {isSoldOut ? 'Sold out' : 'Available'}
              </span>
            </div>
          </CardContent>
        </Card>

        {isSoldOut ? (
          <div class="space-y-2 text-center">
            <p class="font-medium text-destructive">Sorry, this date is sold out.</p>
            <a href="/en/workshops" class="text-primary underline">Browse other dates</a>
          </div>
        ) : (
          <WorkshopReserveForm client:load productVariantId={event.id} locale="en" />
        )}
      </div>
    )}
  </div>
</Layout>