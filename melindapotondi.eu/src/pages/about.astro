---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="Rólam - Melinda Potondi">
	<Navigation />
	
	<Hero 
		titleKey="pages.about.title"
		subtitleKey="pages.about.description"
		class="bg-gradient-to-br from-purple-50 to-pink-100"
	/>

	<section class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-4">
			<div class="prose prose-lg mx-auto">
				<h2>Bemutatkozás</h2>
				<p>
					Üdvözlöm! Ez a rólam szóló oldal, ahol részletesebben bemutatkozom.
				</p>
				<p>
					Itt található minden információ a szakmai hátteremről és tapasztalataimról.
				</p>
			</div>
		</div>
	</section>
</Layout>