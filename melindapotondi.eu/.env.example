# Environment Variables for Brevo Newsletter Integration
# Copy this file to .env and fill in your actual values

# Brevo API Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Brevo List IDs (JSON array format)
# Find your list IDs in Brevo dashboard under Contacts > Lists
# Example: [1, 2, 3] for multiple lists, or [1] for single list
BREVO_LIST_IDS=[1]

# Optional: Brevo API URL (defaults to https://api.brevo.com/v3/contacts)
# BREVO_API_URL=https://api.brevo.com/v3/contacts