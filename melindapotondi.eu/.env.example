# Environment Variables for Brevo Newsletter Integration
# Copy this file to .env and fill in your actual values

# Brevo API Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_URL=https://api.brevo.com/v3/contacts

# Workshop ticket pages password gate (protects /workshops and /en/workshops)
# Set to "false" to make the workshop pages fully public without a code change.
WORKSHOP_GATE_ENABLED=true
# Shared password entered via the 6-box PIN gate. This example value is intentionally
# real ("babuci") since it's a thin, low-security gate for a private-group soft launch,
# not a real secret.
WORKSHOP_GATE_PASSWORD=babuci
# Secret key used to HMAC-sign the gate's access cookie. This placeholder is fine for
# local dev; generate a long random value for production, e.g. `openssl rand -hex 32`.
WORKSHOP_GATE_COOKIE_SECRET=replace-with-a-long-random-production-secret